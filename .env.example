#   postgresql://<user>:<password>@<host>:<POSTGRES_PORT>/<db>?schema=public
# Example for local dev (matches POSTGRES_PORT=15432 above):
#   DATABASE_URL=postgresql://crm:crm_dev_2026@localhost:15432/crm?schema=public
DATABASE_URL=

# Frontends
DASHBOARD_PORT=5174
WEBSITE_PORT=5173

# AI (optional in dev — uses mock provider when missing)
