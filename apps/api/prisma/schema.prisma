generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector(map: "vector"), pg_trgm, unaccent, uuidOssp(map: "uuid-ossp")]
}

model Workspace {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  plan            WorkspacePlan @default(FREE)
  branding        Json          @default("{}")
  primaryLocale   String        @default("ar")
  primaryCurrency String        @default("EGP") @db.Char(3)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  users                   User[]
  teams                   Team[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  roles                   Role[]
  profiles                Profile[]
  userRoles               UserRole[]
  userProfiles            UserProfile[]
  auditLogs               AuditLog[]
  customFieldDefs         CustomFieldDef[]
  userInvites             UserInvite[]
  people                  Person[]
  tags                    Tag[]
  entityTags              EntityTag[]
  lists                   List[]
  pipelines               Pipeline[]
  deals                   Deal[]
  activities              Activity[]
  wonLostReasons          WonLostReason[]
  emailTemplates          EmailTemplate[]
  outboundEmails          OutboundEmail[]
  forms                   Form[]
  formSubmissions         FormSubmission[]
  workflows               Workflow[]
  workflowRuns            WorkflowRun[]
  webhooks                Webhook[]
  webhookDeliveries       WebhookDelivery[]
  validationRules         ValidationRule[]
  dashboards              Dashboard[]
  embeddings              Embedding[]
  aiUsages                AIUsage[]
  productCategories       ProductCategory[]
  products                Product[]
  pricebooks              Pricebook[]
  pricebookEntries        PricebookEntry[]
  quotes                  Quote[]
  quoteLineItems          QuoteLineItem[]
  campaigns               Campaign[]
  campaignRecipients      CampaignRecipient[]
  sequences               Sequence[]
  sequenceEnrollments     SequenceEnrollment[]

  @@index([slug])
}

enum WorkspacePlan {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

model User {
  id              String     @id @default(cuid())
  workspaceId     String
  workspace       Workspace  @relation(fields: [workspaceId], references: [id])
  email           String
  emailNormalized String
  passwordHash    String
  fullName        String
  locale          String     @default("ar")
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  userRoles               UserRole[]
  userProfiles            UserProfile[]
  ownedPeople             Person[]                 @relation("OwnedPeople")
  ownedDeals              Deal[]                   @relation("OwnedDeals")
  ownedActivities         Activity[]               @relation("OwnedActivities")
  dashboards              Dashboard[]
  aiUsages                AIUsage[]

  @@unique([workspaceId, emailNormalized])
  @@index([emailNormalized])
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

model Team {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String
  parentId    String?
  parent      Team?     @relation("TeamHierarchy", fields: [parentId], references: [id])
  children    Team[]    @relation("TeamHierarchy")
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, name])
}

model RefreshToken {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())
  ipAddress    String?
  userAgent    String?

  @@index([workspaceId, userId])
  @@index([tokenHash])
}

model EmailVerificationToken {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, userId])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, userId])
}

model Role {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String
  parentId    String?
  parent      Role?     @relation("RoleHierarchy", fields: [parentId], references: [id])
  children    Role[]    @relation("RoleHierarchy")
  createdAt   DateTime  @default(now())

  users UserRole[]

  @@unique([workspaceId, name])
}

model Profile {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String
  isSystem    Boolean   @default(false)
  permissions String[] // permission keys, e.g. ["person:read","deal:write"]
  createdAt   DateTime  @default(now())

  users UserProfile[]

  @@unique([workspaceId, name])
}

model UserRole {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  roleId      String
  role        Role      @relation(fields: [roleId], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([userId, roleId])
}

model UserProfile {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([userId, profileId])
}

model AuditLog {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  entityType  String
  entityId    String
  fieldKey    String?
  oldValue    Json?
  newValue    Json?
  action      AuditAction
  userId      String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  @@index([workspaceId, entityType, entityId, createdAt])
  @@index([workspaceId, userId, createdAt])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
}

model CustomFieldDef {
  id                   String          @id @default(cuid())
  workspaceId          String
  workspace            Workspace       @relation(fields: [workspaceId], references: [id])
  entityType           String
  key                  String
  label                Json
  type                 CustomFieldType
  options              Json?
  required             Boolean         @default(false)
  unique               Boolean         @default(false)
  indexed              Boolean         @default(false)
  default              Json?
  validation           Json?
  helpText             Json?
  visibleToProfileIds  String[]
  editableByProfileIds String[]
  formulaExpr          String?
  rollupConfig         Json?
  archivedAt           DateTime?
  createdAt            DateTime        @default(now())

  @@unique([workspaceId, entityType, key])
  @@index([workspaceId, entityType])
}

enum CustomFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  DECIMAL
  BOOLEAN
  DATE
  DATETIME
  PICKLIST
  MULTI_PICKLIST
  LOOKUP
  URL
  EMAIL
  PHONE
  FILE
  FORMULA
  ROLLUP
}

model UserInvite {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  email           String
  emailNormalized String
  fullName        String
  invitedById     String?
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@unique([workspaceId, emailNormalized])
  @@index([workspaceId])
}

model Person {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  isCompany Boolean  @default(false)
  parentId  String?
  parent    Person?  @relation("PersonHierarchy", fields: [parentId], references: [id])
  children  Person[] @relation("PersonHierarchy")

  firstName       String?
  lastName        String?
  fullName        String
  companyName     String?
  email           String?
  emailNormalized String?
  phone           String?
  phoneNormalized String?
  title           String?
  industry        String?
  website         String?
  address         Json?

  lifecycleStage LifecycleStage @default(LEAD)
  source         String?
  ownerId        String?
  owner          User?          @relation("OwnedPeople", fields: [ownerId], references: [id])

  customFields Json @default("{}")

  doNotContact Boolean @default(false)
  unsubscribed Boolean @default(false)
  consent      Json?

  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?

  dealsAsPrimary  Deal[] @relation("DealPrimaryContact")
  dealsAsCompany  Deal[] @relation("DealPrimaryCompany")
  quotesAsContact        Quote[] @relation("QuoteContact")
  campaignRecipients     CampaignRecipient[]
  sequenceEnrollments    SequenceEnrollment[]

  @@index([workspaceId, emailNormalized])
  @@index([workspaceId, phoneNormalized])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, lifecycleStage])
  @@index([workspaceId, isCompany])
  @@index([workspaceId, archivedAt])
}

enum LifecycleStage {
  LEAD
  MQL
  SQL
  OPP
  CUSTOMER
  EVANGELIST
}

model Tag {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String
  color       String    @default("#6366f1")
  createdAt   DateTime  @default(now())

  entityTags EntityTag[]

  @@unique([workspaceId, name])
}

model EntityTag {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  tagId       String
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  entityType  String
  entityId    String
  createdAt   DateTime  @default(now())

  @@unique([tagId, entityType, entityId])
  @@index([workspaceId, entityType, entityId])
  @@index([workspaceId, tagId])
}

model List {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  entityType  String
  name        String
  description String?
  isActive    Boolean   @default(true)
  query       Json
  memberIds   String[]
  ownerId     String
  isShared    Boolean   @default(false)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, entityType])
  @@index([workspaceId, ownerId])
}

// ─── Sprint 3: Pipelines + Deals + Activities ───

model Pipeline {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String
  entityType  String    @default("Deal")
  isDefault   Boolean   @default(false)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  stages Stage[]
  deals  Deal[]

  @@unique([workspaceId, entityType, name])
  @@index([workspaceId, entityType])
}

model Stage {
  id                String   @id @default(cuid())
  pipelineId        String
  pipeline          Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name              String
  order             Int
  probability       Int      @default(0)
  color             String   @default("#3b82f6")
  isWon             Boolean  @default(false)
  isLost            Boolean  @default(false)
  requiredFieldKeys String[]
  createdAt         DateTime @default(now())

  deals Deal[]

  @@unique([pipelineId, name])
  @@index([pipelineId, order])
}

model Deal {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  name       String
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id])
  stageId    String
  stage      Stage    @relation(fields: [stageId], references: [id])

  amount            Decimal    @default(0) @db.Decimal(15, 2)
  currency          String     @default("EGP") @db.Char(3)
  expectedCloseDate DateTime?
  probability       Int?

  ownerId String?
  owner   User?   @relation("OwnedDeals", fields: [ownerId], references: [id])

  primaryContactId String?
  primaryContact   Person? @relation("DealPrimaryContact", fields: [primaryContactId], references: [id])
  primaryCompanyId String?
  primaryCompany   Person? @relation("DealPrimaryCompany", fields: [primaryCompanyId], references: [id])

  source     String?
  status     DealStatus @default(OPEN)
  wonAt      DateTime?
  lostAt     DateTime?
  lostReason String?
  wonReason  String?

  lastActivityAt DateTime?
  customFields   Json      @default("{}")

  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?

  quotes      Quote[]

  @@index([workspaceId, pipelineId, stageId, status])
  @@index([workspaceId, ownerId, status])
  @@index([workspaceId, lastActivityAt])
  @@index([workspaceId, archivedAt])
}

enum DealStatus {
  OPEN
  WON
  LOST
}

model Activity {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  parentEntity String
  parentId     String

  type        ActivityType
  subject     String
  body        String?
  status      ActivityStatus @default(OPEN)

  ownerId     String?
  owner       User?    @relation("OwnedActivities", fields: [ownerId], references: [id])
  dueAt       DateTime?
  completedAt DateTime?

  metadata Json @default("{}")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@index([workspaceId, parentEntity, parentId, createdAt])
  @@index([workspaceId, ownerId, status, dueAt])
  @@index([workspaceId, type, createdAt])
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  TASK
  NOTE
  SYSTEM
  FORM_SUBMISSION
}

enum ActivityStatus {
  OPEN
  DONE
  CANCELED
}

model WonLostReason {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  kind        WonLostKind
  label       String
  order       Int       @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, kind, label])
  @@index([workspaceId, kind])
}

enum WonLostKind {
  WON
  LOST
}

// ─── Sprint 4: Email + Forms + Workflow + Webhooks + Validation ───

model EmailTemplate {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String
  subject     String
  body        String    @db.Text
  mergeTagKeys String[]
  category    String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model OutboundEmail {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id])
  toAddress   String
  fromAddress String?
  subject     String
  body        String           @db.Text
  templateId  String?
  entityType  String?
  entityId    String?
  status      OutboundEmailStatus @default(QUEUED)
  providerMessageId String?
  error       String?
  sentAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([workspaceId, entityType, entityId])
  @@index([workspaceId, status])
}

enum OutboundEmailStatus {
  QUEUED
  SENDING
  SENT
  FAILED
}

model Form {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  name         String
  slug         String
  isPublic     Boolean   @default(true)
  redirectUrl  String?
  fields       Json
  mappings     Json      @default("{}")
  successMessage Json?
  useHoneypot  Boolean   @default(true)
  rateLimit    Int       @default(5)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  submissions  FormSubmission[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model FormSubmission {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  formId      String
  form        Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  data        Json
  ipAddress   String?
  userAgent   String?
  personId    String?
  dealId      String?
  createdAt   DateTime  @default(now())

  @@index([formId, createdAt])
  @@index([workspaceId])
}

model Workflow {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  name           String
  entityType     String
  enabled        Boolean   @default(true)
  trigger        Json
  conditions     Json
  actions        Json
  cronExpression String?
  lastRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  runs        WorkflowRun[]

  @@index([workspaceId, entityType, enabled])
}

model WorkflowRun {
  id                String   @id @default(cuid())
  workflowId        String
  workflow          Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id])
  triggeredByEntity String
  triggeredById     String
  status            WorkflowRunStatus @default(QUEUED)
  log               Json?
  error             String?
  triggeredAt       DateTime @default(now())
  completedAt       DateTime?

  @@index([workflowId, triggeredAt])
  @@index([workspaceId, status])
}

enum WorkflowRunStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
}

model Webhook {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  url         String
  secret      String
  events      String[]
  enabled     Boolean   @default(true)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  deliveries  WebhookDelivery[]

  @@index([workspaceId, enabled])
}

model WebhookDelivery {
  id          String    @id @default(cuid())
  webhookId   String
  webhook     Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  eventName   String
  payload     Json
  status      WebhookDeliveryStatus @default(PENDING)
  statusCode  Int?
  responseBody String?  @db.Text
  attemptCount Int      @default(0)
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([webhookId, createdAt])
  @@index([workspaceId, status])
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

model ValidationRule {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  entityType   String
  expression   Json
  errorMessage Json
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([workspaceId, entityType, enabled])
}

model Dashboard {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  name        String
  layout      Json     @default("{\"widgets\":[]}")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, ownerId])
}

model Embedding {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  entityType  String
  entityId    String
  vector      Unsupported("vector(1536)")
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, entityType, entityId])
  @@index([workspaceId, entityType])
}

model AIUsage {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  feature     String
  provider    String
  model       String
  inputTokens Int      @default(0)
  outputTokens Int     @default(0)
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
}

// ─── Sprint 6: Products + Pricebooks ───

model ProductCategory {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String
  labelAr     String?
  labelEn     String?
  parentId    String?
  parent      ProductCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    ProductCategory[] @relation("CategoryHierarchy")
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  products    Product[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Product {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String
  labelAr     String?
  labelEn     String?
  sku         String?
  description String?   @db.Text
  unitPrice   Decimal   @default(0) @db.Decimal(15, 2)
  currency    String    @default("EGP") @db.Char(3)
  isActive    Boolean   @default(true)
  categoryId  String?
  category    ProductCategory? @relation(fields: [categoryId], references: [id])
  customFields Json     @default("{}")
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?

  pricebookEntries PricebookEntry[]
  quoteLineItems   QuoteLineItem[]

  @@unique([workspaceId, sku])
  @@index([workspaceId, isActive])
  @@index([workspaceId, categoryId])
  @@index([workspaceId, archivedAt])
}

model Pricebook {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String
  isDefault   Boolean   @default(false)
  currency    String    @default("EGP") @db.Char(3)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  entries     PricebookEntry[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model PricebookEntry {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  pricebookId String
  pricebook   Pricebook @relation(fields: [pricebookId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitPrice   Decimal   @db.Decimal(15, 2)
  minQty      Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([pricebookId, productId, minQty])
  @@index([workspaceId, pricebookId])
  @@index([workspaceId, productId])
}

// ─── Sprint 7: Quotes / Proposals ───

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quote {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  number      String
  dealId      String?
  deal        Deal?       @relation(fields: [dealId], references: [id])
  contactId   String?
  contact     Person?     @relation("QuoteContact", fields: [contactId], references: [id])
  status      QuoteStatus @default(DRAFT)
  validUntil  DateTime?
  subtotal    Decimal     @default(0) @db.Decimal(15, 2)
  discountPct Decimal     @default(0) @db.Decimal(5, 2)
  discountAmt Decimal     @default(0) @db.Decimal(15, 2)
  taxPct      Decimal     @default(0) @db.Decimal(5, 2)
  taxAmt      Decimal     @default(0) @db.Decimal(15, 2)
  total       Decimal     @default(0) @db.Decimal(15, 2)
  currency    String      @default("EGP") @db.Char(3)
  notes       String?     @db.Text
  sentAt      DateTime?
  acceptedAt  DateTime?
  rejectedAt  DateTime?
  archivedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdById String?
  updatedById String?

  lineItems   QuoteLineItem[]

  @@unique([workspaceId, number])
  @@index([workspaceId, dealId])
  @@index([workspaceId, status])
  @@index([workspaceId, archivedAt])
}

model QuoteLineItem {
  id          String  @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(15, 2)
  discountPct Decimal @default(0) @db.Decimal(5, 2)
  total       Decimal @db.Decimal(15, 2)
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now())

  @@index([quoteId, sortOrder])
  @@index([workspaceId])
}

// ── Sprint 8: Email Marketing Campaigns ────────────────────

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
}

enum RecipientStatus {
  PENDING
  SENT
  OPENED
  CLICKED
  BOUNCED
  UNSUBSCRIBED
}

model Campaign {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id])
  name        String
  subject     String
  body        String         @db.Text
  status      CampaignStatus @default(DRAFT)
  listId      String?
  scheduledAt DateTime?
  sentAt      DateTime?
  stats       Json           @default("{}")
  archivedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdById String?

  recipients CampaignRecipient[]

  @@index([workspaceId, status])
  @@index([workspaceId, archivedAt])
}

model CampaignRecipient {
  id             String          @id @default(cuid())
  workspaceId    String
  workspace      Workspace       @relation(fields: [workspaceId], references: [id])
  campaignId     String
  campaign       Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  personId       String
  person         Person          @relation(fields: [personId], references: [id])
  email          String
  status         RecipientStatus @default(PENDING)
  openedAt       DateTime?
  clickedAt      DateTime?
  bouncedAt      DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime        @default(now())

  @@index([campaignId, status])
  @@index([workspaceId, personId])
}

// ── Sprint 9: Drip Sequences ───────────────────────────────

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  PAUSED
  EXITED
}

model Sequence {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  name         String
  triggerEvent String?
  steps        Json      @default("[]")
  enabled      Boolean   @default(false)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?

  enrollments SequenceEnrollment[]

  @@index([workspaceId, archivedAt])
}

model SequenceEnrollment {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id])
  sequenceId  String
  sequence    Sequence         @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  personId    String
  person      Person           @relation(fields: [personId], references: [id])
  currentStep Int              @default(0)
  status      EnrollmentStatus @default(ACTIVE)
  nextRunAt   DateTime?
  exitedAt    DateTime?
  exitReason  String?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([sequenceId, personId])
  @@index([workspaceId, status])
  @@index([status, nextRunAt])
}
