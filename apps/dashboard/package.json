    "@vueuse/core": "^12.4.0",
    "axios": "^1.7.9",
    "chart.js": "^4.4.7",
    "pinia": "^2.3.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.2.5",
    "vee-validate": "^4.15.0",
    "vue": "^3.5.13",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^10.0.5",
    "vue-router": "^4.5.0",
